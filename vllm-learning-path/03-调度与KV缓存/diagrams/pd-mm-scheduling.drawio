<mxCell id="sm3" value="MM Item Cached&#xa;(embedding in cache)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#C8E6C9;fontSize=10;fontColor=#388E3C;align=center" vertex="1" parent="1"><mxGeometry x="860" y="1268" width="180" height="38" as="geometry"/></mxCell>
