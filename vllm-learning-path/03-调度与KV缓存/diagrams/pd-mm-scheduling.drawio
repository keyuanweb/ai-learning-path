<mxCell id="ds4y" value="Load async from P:&#xa;no budget consumed&#xa;→ external_load_encoder_input" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFCC80;fontSize=10;fontColor=#E65100;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="548" width="180" height="44" as="geometry"/></mxCell>
<mxCell id="ds5" value="Budget OK?&#xa;Cache space&#xa;available?" style="rhombus;html=1;whiteSpace=wrap;;fillColor=#FFF9C4;fontSize=10;fontColor=#F9A825;align=center" vertex="1" parent="1"><mxGeometry x="1020" y="628" width="200" height="56" as="geometry"/></mxCell>
<mxCell id="ds5y" value="Schedule encoding:&#xa;allocate cache slot&#xa;budget -= num_embeds" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#A5D6A7;fontSize=10;fontColor=#388E3C;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="632" width="180" height="44" as="geometry"/></mxCell>
<mxCell id="ds5n" value="Budget/cache full:&#xa;clip num_new_tokens to&#xa;before this MM item&#xa;(or set to 0 if blocked)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFCDD2;fontSize=10;fontColor=#C62828;align=center" vertex="1" parent="1"><mxGeometry x="1020" y="712" width="200" height="44" as="geometry"/></mxCell>
<mxCell id="ds6" value="After scheduling:&#xa;→ encoder forward pass (local MM)&#xa;→ ECConnector.start_load_ec() (remote)&#xa;→ merge embeddings with text tokens" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#F57F17;align=center" vertex="1" parent="1"><mxGeometry x="985" y="780" width="280" height="44" as="geometry"/></mxCell>
