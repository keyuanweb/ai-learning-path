<mxCell id="sm1" value="MM Item Pending&#xa;(not yet encoded)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFF9C4;fontSize=10;fontColor=#F9A825;align=center" vertex="1" parent="1"><mxGeometry x="360" y="1268" width="160" height="38" as="geometry"/></mxCell>
