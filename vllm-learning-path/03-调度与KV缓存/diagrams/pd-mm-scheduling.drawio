                <mxCell id="cnEcX" value="类似KV Transfer但传输的是encoder embeddings而非KV cache&#xa;P侧运行编码器产生embedding→通过EC Connector传给D&#xa;D侧调度时检查远端缓存(ECConnector.has_cache_item)，有则异步加载" style="text;html=1;fontSize=12;fontColor=#004D40;align=left" parent="1" vertex="1">
                    <mxGeometry x="180" y="1250" width="900" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="lifeBox" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;fillStyle=solid;" parent="1" vertex="1">
                    <mxGeometry x="150" y="1370" width="1560" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="lifeT" value="Encoder Cache &amp; Budget Lifecycle + MM-aware Token Budget Interaction" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#E65100;align=center" parent="1" vertex="1">
                    <mxGeometry x="830" y="1375" width="460" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="lf1" value="EncoderCacheManager:&#xa;- check_and_update_cache(mhash)→bool&#xa;- can_allocate(budget, embeds)→bool&#xa;- allocate(req, input_id)&#xa;- free(req) / free_encoder_input(req,id)&#xa;- cache_size from config" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" parent="1" vertex="1">
                    <mxGeometry x="170" y="1410" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="lf2" value="Encoder Compute Budget per step:&#xa;= max_num_encoder_input_tokens&#xa;Decremented as MM inputs scheduled.&#xa;When 0 → no more MM items this step.&#xa;compute_mm_encoder_budget() sets initial." style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" parent="1" vertex="1">
                    <mxGeometry x="470" y="1410" width="260" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="lf3" value="Token Budget vs Encoder Budget:&#xa;Token budget = max_num_batched_tokens&#xa;controls total tokens/step (text+MM)&#xa;Encoder budget controls how many&#xa;encoder tokens can be processed.&#xa;Both independently constrain scheduling." style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" parent="1" vertex="1">
                    <mxGeometry x="770" y="1410" width="280" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="lf4" value="PD EC Interaction:&#xa;P: produces encoder outputs, sends via EC&#xa;D: checks local cache → remote EC cache&#xa;→ loads async from P (like KV async)&#xa;EC cache hit on D = no budget consumed&#xa;(same as KV prefix cache hit)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" parent="1" vertex="1">
                    <mxGeometry x="1090" y="1410" width="270" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="lf5" value="Encoder Modes:&#xa;- disable_chunked_mm_input: don&#39;t split&#xa;  MM item across steps (roll back)&#xa;- Encoder-Decoder: all inputs at pos=0&#xa;- Decoder-only(VLM): MM items inline&#xa;- EC Connector: remote cache for PD" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" parent="1" vertex="1">
                    <mxGeometry x="1400" y="1410" width="280" height="75" as="geometry"/>
