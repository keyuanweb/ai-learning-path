<mxCell id="ds5nT" value="N" style="text;html=1;fontSize=9;fontColor=#C62828;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="698" width="14" height="14" as="geometry"/></mxCell>
<mxCell id="cnDs" value="D调度中文: 多模态在D侧调度时额外检查: ①本地EncoderCache是否命中(已处理过)；②EC Connector远端是否有缓存(P已编码好的)；③encoder budget是否充足；任一不满足→裁剪num_new_tokens，暂缓调度该请求的多模态部分" style="text;html=1;fontSize=7.5;fontColor=#1B5E20;align=left" vertex="1" parent="1"><mxGeometry x="985" y="835" width="800" height="40" as="geometry"/></mxCell>
<mxCell id="ecXfer" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="460" y="865" width="940" height="100" as="geometry"/></mxCell>
<mxCell id="ecXferT" value="EC Transfer: P(Producer) → D(Consumer) Encoder Output Transfer" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#00695C;align=center" vertex="1" parent="1"><mxGeometry x="750" y="870" width="360" height="18" as="geometry"/></mxCell>
<mxCell id="ecX1" value="P Worker: save_ec_layer()&#xa;→ shared memory / RDMA&#xa;→ transfer encoder embeddings" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#B2DFDB;fontSize=10;fontColor=#00695C;align=center" vertex="1" parent="1"><mxGeometry x="480" y="898" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="ecX2" value="D Worker: start_load_ec()&#xa;→ wait_for_layer_load()&#xa;→ merge into decoder input" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#B2DFDB;fontSize=10;fontColor=#00695C;align=center" vertex="1" parent="1"><mxGeometry x="730" y="898" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="ecX3" value="EC Connector Metadata sync&#xa;via API Server (like KV)&#xa;remote_ec_cache lookup" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#80CBC4;fontSize=10;fontColor=#004D40;align=center" vertex="1" parent="1"><mxGeometry x="980" y="898" width="200" height="50" as="geometry"/></mxCell>
<mxCell id="ecX4" value="get_finished():&#xa;finished_recving&#xa;finished_sending" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#80CBC4;fontSize=10;fontColor=#004D40;align=center" vertex="1" parent="1"><mxGeometry x="1230" y="898" width="150" height="50" as="geometry"/></mxCell>
<mxCell id="ecXe1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#00695C;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="ecX1" target="ecX2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="ecXe2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#00695C;strokeWidth=1.5;exitX=1;exitY=0.25;entryX=0;entryY=0.5" edge="1" parent="1" source="ecX1" target="ecX3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="695" y="910"/><mxPoint x="735" y="910"/><mxPoint x="735" y="923"/></Array></mxGeometry></mxCell>
<mxCell id="ecXe3" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#00695C;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5" edge="1" parent="1" source="ecX2" target="ecX4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="cnEcX" value="EC传输中文: 类似KV Transfer但传输的是encoder embeddings而非KV cache。P侧运行编码器产生embedding→通过EC Connector传给D；D侧调度时检查远端缓存(ECConnector.has_cache_item)，有则异步加载" style="text;html=1;fontSize=8;fontColor=#004D40;align=left" vertex="1" parent="1"><mxGeometry x="480" y="955" width="900" height="16" as="geometry"/></mxCell>
<mxCell id="lifeBox" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#E65100;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="20" y="985" width="1820" height="220" as="geometry"/></mxCell>
<mxCell id="lifeT" value="Encoder Cache &amp; Budget Lifecycle + MM-aware Token Budget Interaction" style="text;html=1;fontSize=14;fontStyle=1;fontColor=#E65100;align=center" vertex="1" parent="1"><mxGeometry x="700" y="990" width="460" height="20" as="geometry"/></mxCell>
<mxCell id="lf1" value="EncoderCacheManager:&#xa;- check_and_update_cache(mhash)→bool&#xa;- can_allocate(budget, embeds)→bool&#xa;- allocate(req, input_id)&#xa;- free(req) / free_encoder_input(req,id)&#xa;- cache_size from config" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" vertex="1" parent="1"><mxGeometry x="40" y="1025" width="260" height="75" as="geometry"/></mxCell>
<mxCell id="lf2" value="Encoder Compute Budget per step:&#xa;= max_num_encoder_input_tokens&#xa;Decremented as MM inputs scheduled.&#xa;When 0 → no more MM items this step.&#xa;compute_mm_encoder_budget() sets initial." style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" vertex="1" parent="1"><mxGeometry x="340" y="1025" width="260" height="75" as="geometry"/></mxCell>
<mxCell id="lf3" value="Token Budget vs Encoder Budget:&#xa;Token budget = max_num_batched_tokens&#xa;controls total tokens/step (text+MM)&#xa;Encoder budget controls how many&#xa;encoder tokens can be processed.&#xa;Both independently constrain scheduling." style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" vertex="1" parent="1"><mxGeometry x="640" y="1025" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="lf4" value="PD EC Interaction:&#xa;P: produces encoder outputs, sends via EC&#xa;D: checks local cache → remote EC cache&#xa;→ loads async from P (like KV async)&#xa;EC cache hit on D = no budget consumed&#xa;(same as KV prefix cache hit)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" vertex="1" parent="1"><mxGeometry x="960" y="1025" width="270" height="75" as="geometry"/></mxCell>
<mxCell id="lf5" value="Encoder Modes:&#xa;- disable_chunked_mm_input: don't split&#xa;  MM item across steps (roll back)&#xa;- Encoder-Decoder: all inputs at pos=0&#xa;- Decoder-only(VLM): MM items inline&#xa;- EC Connector: remote cache for PD" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFE0B2;fontSize=10;fontColor=#E65100;align=left" vertex="1" parent="1"><mxGeometry x="1270" y="1025" width="280" height="75" as="geometry"/></mxCell>
<mxCell id="d2life" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#E65100;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="ds6" target="lf4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="836"/><mxPoint x="1415" y="836"/><mxPoint x="1415" y="1015"/></Array></mxGeometry></mxCell>
