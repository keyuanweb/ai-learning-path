                </mxCell>
                <mxCell id="cnDs" value="多模态在D侧调度时额外检查:&#xa;①本地EncoderCache是否命中(已处理过)&#xa;②EC Connector远端是否有缓存(P已编码好的)&#xa;③encoder budget是否充足；任一不满足→裁剪num_new_tokens暂缓调度" style="text;html=1;fontSize=12;fontColor=#1B5E20;align=left" parent="1" vertex="1">
                    <mxGeometry x="985" y="860" width="820" height="75" as="geometry"/>
                </mxCell>
                <mxCell id="ecXfer" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#E0F2F1;strokeColor=#00695C;strokeWidth=1.5;" parent="1" vertex="1">
                    <mxGeometry x="150" y="1160" width="940" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="ecXferT" value="EC Transfer: P(Producer) → D(Consumer) Encoder Output Transfer" style="text;html=1;fontSize=13;fontStyle=1;fontColor=#00695C;align=center" parent="1" vertex="1">
                    <mxGeometry x="170" y="1120" width="430" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="ecX1" value="P Worker: save_ec_layer()&#xa;→ shared memory / RDMA&#xa;→ transfer encoder embeddings" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#B2DFDB;fontSize=10;fontColor=#00695C;align=center" parent="1" vertex="1">
                    <mxGeometry x="180" y="1195" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ecX2" value="D Worker: start_load_ec()&#xa;→ wait_for_layer_load()&#xa;→ merge into decoder input" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#B2DFDB;fontSize=10;fontColor=#00695C;align=center" parent="1" vertex="1">
                    <mxGeometry x="430" y="1195" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ecX3" value="EC Connector Metadata sync&#xa;via API Server (like KV)&#xa;remote_ec_cache lookup" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#80CBC4;fontSize=10;fontColor=#004D40;align=center" parent="1" vertex="1">
                    <mxGeometry x="680" y="1195" width="200" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ecX4" value="get_finished():&#xa;finished_recving&#xa;finished_sending" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#80CBC4;fontSize=10;fontColor=#004D40;align=center" parent="1" vertex="1">
                    <mxGeometry x="930" y="1195" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="ecXe1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#00695C;strokeWidth=1.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5" parent="1" source="ecX1" target="ecX2" edge="1">
