<mxCell id="pret" value="Preemption (D-side: KV full, main scenario)" style="text;html=1;fontSize=12;fontStyle=1;fontColor=#C62828;align=center" vertex="1" parent="1"><mxGeometry x="1270" y="1375" width="300" height="20" as="geometry"/></mxCell>
<mxCell id="cnPret" value="D侧抢占(主要): 每个decode请求持有全部历史KV，每步+1token持续增长直到EOS；KV满时allocate_slots()失败→选受害者(FCFS pop最后/ Priority max优先级最低)→释放块,num_computed=0→放回waiting头部" style="text;html=1;fontSize=7.5;fontColor=#C62828;align=left" vertex="1" parent="1"><mxGeometry x="990" y="1390" width="830" height="14" as="geometry"/></mxCell>
<mxCell id="preNote" value="D-side Preemption Flow (same as P):&#xa;allocate_slots() fails for RUNNING decode request -&gt; select victim (FCFS pop last / Priority max)&#xa;-&gt; _preempt_request(): free blocks, num_computed=0, PREEMPTED, prepend waiting&#xa;-&gt; retry allocate; if victim == self -&gt; break (cannot schedule)&#xa;D-side preemption is common: each decode req holds all historical KV, growing 1t/step until EOS.&#xa;P-side preemption is rare: KV held only during prefill chunk, released after transfer to D." style="text;html=1;fontSize=9;fontColor=#C62828;align=left" vertex="1" parent="1"><mxGeometry x="990" y="1405" width="830" height="140" as="geometry"/></mxCell>
<mxCell id="smbx" value="" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#BDBDBD;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="1570" width="600" height="195" as="geometry"/></mxCell>
<mxCell id="smt" value="Request State Machine (请求状态机)" style="text;html=1;fontSize=14;fontStyle=1;align=center" vertex="1" parent="1"><mxGeometry x="580" y="1575" width="220" height="22" as="geometry"/></mxCell>
<mxCell id="smw" value="WAITING&#xa;(等待调度)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#FFF9C4;fontStyle=1;fontColor=#F9A825;align=center" vertex="1" parent="1"><mxGeometry x="420" y="1608" width="120" height="42" as="geometry"/></mxCell>
<mxCell id="smr" value="RUNNING&#xa;(正在执行)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#C8E6C9;fontStyle=1;fontColor=#388E3C;align=center" vertex="1" parent="1"><mxGeometry x="650" y="1608" width="120" height="42" as="geometry"/></mxCell>
<mxCell id="smf" value="FINISHED&#xa;(已完成)" style="rounded=1;html=1;whiteSpace=wrap;;fillColor=#E0E0E0;fontStyle=1;fontColor=#9E9E9E;align=center" vertex="1" parent="1"><mxGeometry x="870" y="1608" width="100" height="42" as="geometry"/></mxCell>
