          <mxGeometry x="50" y="380" width="80" height="16" as="geometry" />
        </mxCell>

        <!-- ==================== ANNOTATIONS ==================== -->
        <mxCell id="prod-notes" value="&lt;b&gt;📋 生产部署清单&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;☐ nodeSelector: nvidia.com/gpu.present=true&lt;br&gt;☐ tolerations: GPU taint NoSchedule&lt;br&gt;☐ livenessProbe: /health (delay 120s+)&lt;br&gt;☐ readinessProbe: /health (delay 60s+)&lt;br&gt;☐ resources.limits.nvidia.com/gpu: 1&lt;br&gt;☐ ConfigMap: 模型参数 / Secret: API Key&lt;br&gt;☐ HPA: 自定义指标 (QPS/TTFT)&lt;br&gt;☐ PVC/initContainer: 模型权重&lt;br&gt;☐ Prometheus ServiceMonitor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#EAB308;strokeWidth=1;fontSize=10;fontColor=#854D0E;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1090" y="400" width="250" height="170" as="geometry" />
        </mxCell>

        <mxCell id="pitfalls" value="&lt;b&gt;⚠️ 常见坑&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;① GPU 资源名是 nvidia.com/gpu&lt;br&gt;   需要 NVIDIA Device Plugin&lt;br&gt;② LLM 启动慢，Probe initialDelay&lt;br&gt;   需要 &gt;120s&lt;br&gt;③ CPU 指标不适用 GPU 推理 HPA&lt;br&gt;   建议 QPS/队列深度/TTFT&lt;br&gt;④ 模型+KV Cache 需准确估算&lt;br&gt;   memory limits，避免 OOM&lt;br&gt;⑤ vLLM TP 需要单 Pod 多 GPU&lt;br&gt;   不能用 Deployment 简单扩展&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1;fontSize=10;fontColor=#991B1B;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1370" y="400" width="240" height="170" as="geometry" />
        </mxCell>

        <mxCell id="flow-summary" value="&lt;b&gt;🔄 推理请求流程&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;Client → Ingress (TLS 终止) → Service (ClusterIP)&lt;br&gt;→ kube-proxy (iptables/IPVS) → vLLM Pod (GPU)&lt;br&gt;→ vLLM Engine 推理 → 返回 streaming text&lt;br&gt;&lt;br&gt;HPA 根据指标动态调整 replica 数量&lt;br&gt;ConfigMap/Secret 通过 env/volume 注入配置&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=1.5;fontSize=10;fontColor=#166534;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="840" width="1025" height="100" as="geometry" />
        </mxCell>

