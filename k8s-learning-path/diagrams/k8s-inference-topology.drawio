        <!-- Service → Pod 2 -->
        <mxCell id="edge-svc-pod2" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#16A34A;strokeWidth=2;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="service" target="pod2-container" edge="1">
