        <!-- ConfigMap → Pod 1: from side panel left and down -->
        <mxCell id="edge-cm-pod1" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#F59E0B;strokeWidth=1.5;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" source="configmap" target="pod1-container" edge="1">
