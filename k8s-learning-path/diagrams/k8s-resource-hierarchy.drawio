        <!-- ns-1 → Deploy: top-down, center to center -->
        <mxCell id="edge-ns1-deploy" style="edgeStyle=orthogonalEdgeStyle;endArrow=classic;html=1;strokeColor=#22C55E;strokeWidth=1.5;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="ns-1" target="deploy-container" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="310" />
