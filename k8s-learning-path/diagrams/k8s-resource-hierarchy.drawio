        <!-- ==================== ANNOTATIONS ==================== -->
        <mxCell id="rel-summary" value="&lt;b&gt;📐 核心关系总结&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;Cluster ─contains→ Namespace ─contains→ Workload ─manages→ Pod ─runs→ Container&lt;br&gt;Service ─selects→ Pod (via labels)&lt;br&gt;Ingress ─routes→ Service&lt;br&gt;ConfigMap/Secret ─injects→ Pod (env / volume mount)&lt;br&gt;PVC ─mounts→ Pod (PersistentVolume)&lt;br&gt;HPA ─scales→ Deployment/StatefulSet&lt;br&gt;NetworkPolicy ─controls→ Pod ingress/egress&lt;br&gt;ServiceAccount ─attaches→ Pod (RBAC)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEFCE8;strokeColor=#EAB308;strokeWidth=1;fontSize=10;fontColor=#854D0E;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1090" y="70" width="500" height="160" as="geometry" />
        </mxCell>

        <mxCell id="patterns" value="&lt;b&gt;🔑 关键模式&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;&lt;br&gt;① &lt;b&gt;Label &amp; Selector&lt;/b&gt; — 松耦合绑定机制&lt;br&gt;  Service → Pod (app=web)&lt;br&gt;  Deployment → Pod (matchLabels)&lt;br&gt;&lt;br&gt;② &lt;b&gt;声明式管理&lt;/b&gt; — YAML → API Server → Controller&lt;br&gt;  Controller 持续 reconcile 期望 vs 实际&lt;br&gt;&lt;br&gt;③ &lt;b&gt;Owner Reference&lt;/b&gt; — 级联删除链&lt;br&gt;  Deployment → ReplicaSet → Pod&lt;br&gt;&lt;br&gt;④ &lt;b&gt;Immutable Infrastructure&lt;/b&gt;&lt;br&gt;  Pod 不可变，更新 = 新建 + 销毁旧&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#22C55E;strokeWidth=1.5;fontSize=10;fontColor=#166534;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1090" y="250" width="500" height="190" as="geometry" />
        </mxCell>

        <mxCell id="yaml-example" value="&lt;b&gt;📝 声明式 YAML 示例&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:monospace&quot;&gt;apiVersion: apps/v1&lt;br&gt;kind: Deployment&lt;br&gt;metadata:&lt;br&gt;  name: web-deploy&lt;br&gt;  namespace: k8s-learn&lt;br&gt;spec:&lt;br&gt;  replicas: 3&lt;br&gt;  selector:&lt;br&gt;    matchLabels:&lt;br&gt;      app: web&lt;br&gt;  template:&lt;br&gt;    metadata:&lt;br&gt;      labels:&lt;br&gt;        app: web&lt;br&gt;    spec:&lt;br&gt;      containers:&lt;br&gt;      - name: nginx&lt;br&gt;        image: nginx:1.25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;fontSize=9;fontColor=#334155;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
          <mxGeometry x="1090" y="460" width="250" height="210" as="geometry" />
        </mxCell>

        <mxCell id="kubectl-cmds" value="&lt;b&gt;⚡ 常用查询命令&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;font-family:monospace&quot;&gt;&lt;br&gt;# 查看资源层级&lt;br&gt;kubectl get all -n k8s-learn&lt;br&gt;&lt;br&gt;# 查看 ownerReferences&lt;br&gt;kubectl get pod -o json \&lt;br&gt;  | jq '.metadata.ownerReferences'&lt;br&gt;&lt;br&gt;# 查看标签&lt;br&gt;kubectl get pods --show-labels&lt;br&gt;&lt;br&gt;# 查看 Service 后端&lt;br&gt;kubectl get endpoints web-svc&lt;br&gt;&lt;br&gt;# 列出所有 API 资源&lt;br&gt;kubectl api-resources&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1;fontSize=9;fontColor=#334155;verticalAlign=middle;align=left;spacingLeft=8;" parent="1" vertex="1">
