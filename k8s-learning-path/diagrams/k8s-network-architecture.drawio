<mxfile host="app.diagrams.net" modified="2026-08-02" agent="draw.io">
  <diagram name="K8s Network Architecture" id="k8s-network">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Kubernetes 网络与服务架构" style="text;html=1;fontSize=24;fontColor=#1E3A8A;verticalAlign=middle;align=center;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="420" y="10" width="600" height="40" as="geometry" />
