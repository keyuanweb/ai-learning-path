        <mxCell id="client" value="&lt;b&gt;外部客户端&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;浏览器 · API 调用 · gRPC&lt;/font&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=2;fontSize=11;fontColor=#334155;verticalAlign=middle;align=center;" parent="1" vertex="1">
