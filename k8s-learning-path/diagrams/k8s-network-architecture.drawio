          <mxGeometry x="280" y="100" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cloud-lb" value="&lt;b&gt;云负载均衡器&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;AWS NLB · GCLB · Azure LB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=2;fontSize=11;fontColor=#3730A3;verticalAlign=middle;align=center;" parent="1" vertex="1">
