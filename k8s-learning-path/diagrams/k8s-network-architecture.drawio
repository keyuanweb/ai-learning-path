        </mxCell>
        <mxCell id="ingress-ctrl" value="&lt;b&gt;Ingress Controller&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;nginx-ingress · Traefik · Contour&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=2;fontSize=11;fontColor=#3730A3;verticalAlign=middle;align=center;" parent="1" vertex="1">
          <mxGeometry x="770" y="100" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gateway-api" value="&lt;b&gt;Gateway API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;GatewayClass · Gateway · HTTPRoute&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=2;fontSize=11;fontColor=#3730A3;verticalAlign=middle;align=center;" parent="1" vertex="1">
          <mxGeometry x="1060" y="100" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="tls" value="&lt;b&gt;TLS 终止&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;cert-manager · Let's Encrypt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=11;fontColor=#92400E;verticalAlign=middle;align=center;" parent="1" vertex="1">
