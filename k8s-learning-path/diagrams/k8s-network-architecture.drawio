          <mxGeometry x="30" y="200" width="1580" height="200" as="geometry" />
        </mxCell>
        <mxCell id="svc-title" value="Service 服务发现层 (kube-proxy 实现负载均衡)" style="text;html=1;fontSize=15;fontColor=#1E40AF;verticalAlign=middle;align=center;fontStyle=1;" parent="1" vertex="1">
